<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 30px;
      text-align: center;
      border-radius: 8px 8px 0 0;
    }
    .content {
      background: #f9f9f9;
      padding: 30px;
      border: 1px solid #ddd;
      border-top: none;
    }
    .button {
      display: inline-block;
      background: #667eea;
      color: white;
      padding: 12px 30px;
      text-decoration: none;
      border-radius: 5px;
      margin: 20px 0;
    }
    .org-badge {
      display: inline-block;
      background: #ede9fe;
      color: #5b21b6;
      padding: 5px 14px;
      border-radius: 15px;
      font-weight: bold;
      margin: 10px 0;
      font-size: 15px;
    }
    .footer {
      text-align: center;
      padding: 20px;
      color: #666;
      font-size: 12px;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>You're Invited!</h1>
    <p style="margin:0; opacity:0.9;">Join your team on StandupSnap</p>
  </div>
  <div class="content">
    <p>Hello,</p>
    <p>You've been invited to join the organization:</p>
    <p><span class="org-badge">{{organizationName}}</span></p>

    <p>StandupSnap helps teams run focused standups, track progress, and ship faster. Click below to create your account and get started:</p>

    <p style="text-align: center;">
      <a href="{{inviteUrl}}" class="button">Accept Invitation</a>
    </p>

    <p>Or copy and paste this link into your browser:</p>
    <p style="word-break: break-all; color: #666; font-size: 12px;">{{inviteUrl}}</p>

    <p><strong>Note:</strong> This invitation will expire in 7 days.</p>
  </div>
  <div class="footer">
    <p>This email was sent to {{email}}</p>
    <p>&copy; StandupSnap</p>
  </div>
</body>
</html>
